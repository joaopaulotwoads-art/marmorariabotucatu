---
interface Props {
  name: string;
  text: string;
  rating: number;
  location: string;
}

const { name, text, rating, location } = Astro.props;

const initials = name
  .split(" ")
  .map((n) => n[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<article class="flex flex-col rounded-2xl bg-white p-6 shadow-sm border border-stone-100 transition-all duration-300 hover:shadow-md">
  <!-- Quote mark -->
  <svg class="h-8 w-8 text-gold/30 mb-4" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zm-14.017 0v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H0z"/>
  </svg>

  <!-- Stars -->
  <div class="flex gap-0.5 mb-3">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        class={`h-4 w-4 ${i < rating ? "text-gold" : "text-stone-200"}`}
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
    ))}
  </div>

  <!-- Text -->
  <p class="flex-1 text-sm leading-relaxed text-stone-600 italic">
    "{text}"
  </p>

  <!-- Author -->
  <div class="mt-5 flex items-center gap-3 pt-4 border-t border-stone-100">
    <div class="flex h-10 w-10 items-center justify-center rounded-full bg-stone-900 text-sm font-semibold text-gold">
      {initials}
    </div>
    <div>
      <p class="text-sm font-semibold text-stone-800">{name}</p>
      <p class="text-xs text-stone-400">{location}</p>
    </div>
  </div>
</article>
