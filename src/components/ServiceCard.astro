---
interface Props {
  title: string;
  description: string;
  image: string;
  alt: string;
  href?: string;
}

const { title, description, image, alt, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class="group block overflow-hidden rounded-2xl bg-white shadow-sm border border-stone-100 transition-all duration-300 hover:shadow-xl hover:shadow-stone-200/50 hover:-translate-y-1"
>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={alt}
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
  </div>

  <!-- Content -->
  <div class="p-6">
    <h3 class="font-serif text-lg font-semibold text-stone-800 group-hover:text-gold transition-colors duration-300">
      {title}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-stone-500">
      {description}
    </p>
    <div class="mt-4 flex items-center gap-1 text-sm font-medium text-gold opacity-0 translate-x-[-8px] transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-0">
      <span>Ver detalhes</span>
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
    </div>
  </div>
</Tag>
