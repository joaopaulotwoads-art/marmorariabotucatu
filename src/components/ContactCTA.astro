---
const whatsappLink = "https://wa.me/5514981651674?text=Olá! Vim através do marmorariabotucatu.com.br e gostaria de solicitar um orçamento.";
---

<section id="contato" class="relative py-20 lg:py-28 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <img
      src="/images/about.webp"
      alt="Marmoraria Botucatu - Solicite seu orçamento"
      class="h-full w-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-stone-950/85"></div>
  </div>

  <!-- Content -->
  <div class="reveal relative z-10 mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
    <span class="text-sm font-semibold tracking-widest uppercase text-gold">Pronto para começar?</span>
    <h2 class="mt-4 font-serif text-3xl font-bold text-white sm:text-4xl lg:text-5xl">
      Solicite Seu Orçamento <span class="text-gold">Gratuito</span>
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-stone-300">
      Entre em contato conosco pelo WhatsApp e receba um orçamento personalizado
      para seu projeto. Medição gratuita em Botucatu!
    </p>

    <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
      <a
        href={whatsappLink}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-[#25D366]/25 transition-all hover:bg-[#1fb855] hover:shadow-xl hover:-translate-y-0.5"
        id="cta-whatsapp-main"
      >
        <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 0 0 .917.918l4.458-1.495A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.35 0-4.531-.69-6.379-1.872l-.447-.287-2.648.888.888-2.648-.287-.447A9.724 9.724 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
        Chamar no WhatsApp
      </a>
      <a
        href="tel:+5514981651674"
        class="inline-flex items-center gap-2 rounded-full border border-white/20 px-8 py-4 text-base font-medium text-white transition-all hover:bg-white/10 hover:border-white/40"
        id="cta-phone"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
        (14) 98165-1674
      </a>
    </div>
  </div>
</section>
