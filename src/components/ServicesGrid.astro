---
import ServiceCard from "./ServiceCard.astro";
import { services } from "../data/services";
---

<section id="servicos" class="py-20 lg:py-28 bg-stone-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="reveal mx-auto max-w-2xl text-center">
      <span class="text-sm font-semibold tracking-widest uppercase text-gold">O que fazemos</span>
      <h2 class="mt-3 font-serif text-3xl font-bold text-stone-800 sm:text-4xl lg:text-5xl">
        Nossos Serviços
      </h2>
      <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gold"></div>
      <p class="mt-6 text-lg leading-relaxed text-stone-500">
        Oferecemos soluções completas em mármore, granito e porcelanato para transformar
        cada ambiente com elegância e durabilidade.
      </p>
    </div>

    <!-- Grid -->
    <div class="reveal mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          image={service.image}
          alt={service.alt}
          href={`/servicos/${service.slug}/`}
        />
      ))}
    </div>
  </div>
</section>
