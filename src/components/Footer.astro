---
import { services } from "../data/services";
const currentYear = new Date().getFullYear();


const bairros = [
  "Centro",
  "Chácaras Reunidas Vista Alegre",
  "Vila dos Lavradores",
  "Jardim Paraíso",
  "Jardim Dona Nicota",
  "Vila Assumpção",
  "Jardim Iolanda",
  "Rubião Júnior",
  "Jardim Bom Pastor",
  "Vila São Lúcio",
  "Jardim Continental",
];

const whatsappLink = "https://wa.me/5514981651674?text=Olá! Vim através do marmorariabotucatu.com.br e gostaria de solicitar um orçamento.";
---

<footer class="bg-stone-900 text-stone-400">
  <!-- Main Footer -->
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Column 1: About -->
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-gold">
            <span class="font-serif text-xl font-bold text-white">M</span>
          </div>
          <div>
            <span class="block text-lg font-serif font-semibold text-white leading-tight">Marmoraria</span>
            <span class="block text-xs tracking-widest uppercase text-stone-500">Botucatu</span>
          </div>
        </div>
        <p class="text-sm leading-relaxed">
          Há mais de 15 anos transformando ambientes em Botucatu com mármore, granito e
          porcelanato de alto padrão.
        </p>
        <!-- Social Icons -->
        <div class="mt-6 flex gap-3">
          <a
            href="#"
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-stone-800 text-stone-400 transition-all hover:bg-gold hover:text-white"
            aria-label="Instagram"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a
            href="#"
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-stone-800 text-stone-400 transition-all hover:bg-gold hover:text-white"
            aria-label="Facebook"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-lg bg-stone-800 text-stone-400 transition-all hover:bg-[#25D366] hover:text-white"
            aria-label="WhatsApp"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 0 0 .917.918l4.458-1.495A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.35 0-4.531-.69-6.379-1.872l-.447-.287-2.648.888.888-2.648-.287-.447A9.724 9.724 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-white mb-5">Serviços</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a href={`/servicos/${service.slug}/`} class="text-sm text-stone-400 hover:text-gold transition-colors">{service.title}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Contact -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-white mb-5">Contato</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 mt-0.5 text-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
            <span class="text-sm">Av. Milton Aparecido de Oliveira<br />Chácaras Reunidas Vista Alegre<br />Botucatu - SP, 18606-340</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 mt-0.5 text-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z" /></svg>
            <div class="text-sm">
              <a href="tel:+5514981651674" class="text-stone-400 hover:text-gold transition-colors">(14) 98165-1674</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 mt-0.5 text-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
            <div class="text-sm">
              <a href="mailto:contato@marmorariabotucatu.com.br" class="text-stone-400 hover:text-gold transition-colors">contato@marmorariabotucatu.com.br</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="h-5 w-5 mt-0.5 text-gold flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            <div class="text-sm">
              <span>Seg - Sex: 8h às 18h</span><br />
              <span>Sáb: 8h às 12h</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- Column 4: Map + Bairros -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-white mb-5">Localização</h3>
        <!-- Google Maps Embed -->
        <div class="overflow-hidden rounded-xl mb-4">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3677.0!2d-48.4449!3d-22.8859!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zQXYuIE1pbHRvbiBBcGFyZWNpZG8gZGUgT2xpdmVpcmEgLSBDaMOhY2FyYXMgUmV1bmlkYXMgVmlzdGEgQWxlZ3JlLCBCb3R1Y2F0dSAtIFNQ!5e0!3m2!1spt-BR!2sbr"
            width="100%"
            height="160"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de Botucatu SP"
          ></iframe>
        </div>

        <!-- Bairros -->
        <p class="text-xs text-stone-500 mb-2">Bairros atendidos:</p>
        <div class="flex flex-wrap gap-1.5">
          {bairros.map((bairro) => (
            <span class="inline-block rounded-md bg-stone-800 px-2 py-0.5 text-xs text-stone-400">
              {bairro}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-stone-800">
    <div class="mx-auto max-w-7xl px-4 py-5 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center gap-2 sm:flex-row sm:justify-between">
        <p class="text-xs text-stone-500">
          © {currentYear} Marmoraria Botucatu. Todos os direitos reservados.
        </p>
        <p class="text-xs text-stone-600">
          CNPJ: 40.063.508/0001-53 — Marmoraria em Botucatu, SP
        </p>
      </div>
    </div>
  </div>
</footer>
