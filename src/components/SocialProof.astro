---
const stats = [
  { value: "15+", label: "Anos de Experiência" },
  { value: "500+", label: "Projetos Realizados" },
  { value: "100%", label: "Clientes Satisfeitos" },
];
---

<section class="relative border-b border-stone-200 bg-white py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-center sm:gap-12 lg:gap-20">
      <!-- Trust badge -->
      <div class="flex items-center gap-2 text-sm text-stone-500">
        <svg class="h-5 w-5 text-gold" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        <span class="font-medium">Aprovada por Arquitetos e Clientes de Botucatu</span>
      </div>

      <!-- Divider -->
      <div class="hidden h-8 w-px bg-stone-200 sm:block"></div>

      <!-- Stats -->
      {stats.map((stat) => (
        <div class="flex items-center gap-3 text-center">
          <span class="text-2xl font-serif font-bold text-stone-800">{stat.value}</span>
          <span class="text-sm text-stone-500 text-left leading-tight">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
