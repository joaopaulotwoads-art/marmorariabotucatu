---
const stats = [
  { value: "Medição", label: "100% Gratuita" },
  { value: "Chapas", label: "Estoque Próprio" },
  { value: "Botucatu", label: "E Região" },
];
---

<section class="relative border-b border-stone-200 bg-white py-8">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:justify-center sm:gap-12 lg:gap-20">
      <!-- Stats -->
      {stats.map((stat) => (
        <div class="flex items-center gap-3 text-center">
          <span class="text-2xl font-serif font-bold text-stone-800">{stat.value}</span>
          <span class="text-sm text-stone-500 text-left leading-tight">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
