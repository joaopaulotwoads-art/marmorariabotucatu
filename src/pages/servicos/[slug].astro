---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppButton from "../../components/WhatsAppButton.astro";
import ServiceCard from "../../components/ServiceCard.astro";
import { services, getServiceBySlug, getOtherServices } from "../../data/services";
import type { GetStaticPaths } from "astro";

export const getStaticPaths: GetStaticPaths = () => {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
};

const { slug } = Astro.params;
const service = getServiceBySlug(slug as string)!;
const otherServices = getOtherServices(slug as string);
const whatsappLink = `https://wa.me/5514981651674?text=Olá! Vim através do marmorariabotucatu.com.br e gostaria de solicitar um orçamento para ${service.title}.`;
---

<Layout title={service.metaTitle} description={service.metaDescription}>
  <Header />

  <main>
    <!-- Hero Banner -->
    <section class="relative pt-24 pb-16 lg:pt-32 lg:pb-24 bg-stone-950 overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0">
        <img
          src={service.image}
          alt={service.alt}
          class="h-full w-full object-cover opacity-30"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/80 to-stone-950/50"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-stone-950/60"></div>
      </div>

      <!-- Decorative lines -->
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
      <div class="absolute bottom-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/20 to-transparent"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Breadcrumb -->
        <nav class="mb-8 flex items-center gap-2 text-sm" aria-label="Breadcrumb">
          <a href="/" class="text-stone-400 hover:text-gold transition-colors">Início</a>
          <svg class="h-4 w-4 text-stone-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
          <a href="/#servicos" class="text-stone-400 hover:text-gold transition-colors">Serviços</a>
          <svg class="h-4 w-4 text-stone-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
          <span class="text-gold">{service.title}</span>
        </nav>

        <!-- Badge -->
        <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-gold/20 bg-gold/5 px-5 py-2 backdrop-blur-md">
          <span class="h-2 w-2 rounded-full bg-gold animate-pulse"></span>
          <span class="text-xs font-semibold tracking-[0.2em] text-gold uppercase">Serviço Especializado</span>
        </div>

        <!-- Title -->
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white max-w-3xl leading-[1.1]">
          {service.title}
        </h1>

        <!-- Short Description -->
        <p class="mt-6 text-lg sm:text-xl text-stone-400 max-w-2xl leading-relaxed">
          {service.description}
        </p>

        <!-- CTA -->
        <div class="mt-8">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-2.5 rounded-full bg-gold px-8 py-4 text-base font-semibold text-stone-950 shadow-2xl shadow-gold/20 transition-all duration-300 hover:bg-gold-light hover:shadow-gold/40 hover:-translate-y-0.5"
          >
            <svg class="h-5 w-5 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 0 0 .917.918l4.458-1.495A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.35 0-4.531-.69-6.379-1.872l-.447-.287-2.648.888.888-2.648-.287-.447A9.724 9.724 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
            Solicitar Orçamento
          </a>
        </div>
      </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-start">
          <!-- Left: Image -->
          <div class="relative">
            <div class="overflow-hidden rounded-2xl shadow-xl">
              <img
                src={service.image}
                alt={service.alt}
                class="h-full w-full object-cover aspect-[4/3]"
                loading="lazy"
              />
            </div>
            <!-- Decorative corner -->
            <div class="absolute -top-4 -left-4 h-20 w-20 rounded-tl-2xl border-l-4 border-t-4 border-gold/30 hidden lg:block"></div>
            <div class="absolute -bottom-4 -right-4 h-20 w-20 rounded-br-2xl border-r-4 border-b-4 border-gold/20 hidden lg:block"></div>
          </div>

          <!-- Right: Details -->
          <div>
            <span class="text-sm font-semibold tracking-widest uppercase text-gold">Detalhes do Serviço</span>
            <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">
              {service.title}
            </h2>
            <div class="mt-4 h-1 w-12 rounded-full bg-gold"></div>

            <p class="mt-6 text-base leading-relaxed text-stone-600">
              {service.longDescription}
            </p>

            <!-- Features -->
            <div class="mt-8">
              <h3 class="text-sm font-semibold tracking-widest uppercase text-stone-800 mb-4">O que inclui</h3>
              <ul class="space-y-3">
                {service.features.map((feature) => (
                  <li class="flex items-start gap-3">
                    <div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gold/10">
                      <svg class="h-3.5 w-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    </div>
                    <span class="text-stone-600 text-sm">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Materials -->
            <div class="mt-8">
              <h3 class="text-sm font-semibold tracking-widest uppercase text-stone-800 mb-4">Materiais Disponíveis</h3>
              <div class="flex flex-wrap gap-2">
                {service.materials.map((material) => (
                  <span class="inline-block rounded-full border border-stone-200 bg-stone-50 px-4 py-1.5 text-xs font-medium text-stone-600">
                    {material}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Differentials mini section -->
    <section class="py-16 bg-stone-50 border-y border-stone-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-3">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gold/10 text-gold">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.746 3.746 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" /></svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-stone-800">Medição Gratuita</h3>
              <p class="mt-1 text-sm text-stone-500">Nossa equipe vai até você em Botucatu sem custo algum.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gold/10 text-gold">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.049.58.025 1.193-.14 1.743" /></svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-stone-800">Acabamento Premium</h3>
              <p class="mt-1 text-sm text-stone-500">Precisão milimétrica com equipamentos de última geração.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-gold/10 text-gold">
              <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
            </div>
            <div>
              <h3 class="font-serif text-lg font-semibold text-stone-800">Entrega Rápida</h3>
              <p class="mt-1 text-sm text-stone-500">Logística ágil para toda Botucatu e região.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 lg:py-20 bg-stone-950">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-sm font-semibold tracking-widest uppercase text-gold">Pronto para começar?</span>
        <h2 class="mt-4 font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white">
          Solicite Seu Orçamento <span class="text-gold">Gratuito</span>
        </h2>
        <p class="mt-4 text-stone-400 max-w-xl mx-auto">
          Entre em contato pelo WhatsApp e receba um orçamento personalizado para o seu projeto de {service.title.toLowerCase()}.
        </p>
        <div class="mt-8">
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-white shadow-lg shadow-[#25D366]/25 transition-all hover:bg-[#1fb855] hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 0 0 .917.918l4.458-1.495A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.35 0-4.531-.69-6.379-1.872l-.447-.287-2.648.888.888-2.648-.287-.447A9.724 9.724 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
            Chamar no WhatsApp
          </a>
        </div>
      </div>
    </section>

    <!-- Other Services -->
    <section class="py-16 lg:py-24 bg-stone-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-12">
          <span class="text-sm font-semibold tracking-widest uppercase text-gold">Explore mais</span>
          <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">
            Outros Serviços
          </h2>
          <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gold"></div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {otherServices.slice(0, 3).map((s) => (
            <ServiceCard
              title={s.title}
              description={s.description}
              image={s.image}
              alt={s.alt}
              href={`/servicos/${s.slug}/`}
            />
          ))}
        </div>

        <div class="mt-10 text-center">
          <a
            href="/#servicos"
            class="inline-flex items-center gap-2 text-sm font-semibold text-gold hover:text-gold-dark transition-colors"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" /></svg>
            Ver todos os serviços
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
