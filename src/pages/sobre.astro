---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import Differentials from "../components/Differentials.astro";
import { services } from "../data/services";

const whatsappLink = "https://wa.me/5514981651674?text=Olá! Gostaria de saber mais sobre a Marmoraria Botucatu.";

const timeline = [
  { year: "2009", title: "Fundação", text: "Início das atividades em Botucatu com foco em acabamentos residenciais." },
  { year: "2013", title: "Expansão", text: "Ampliação da fábrica e aquisição de equipamentos CNC de última geração." },
  { year: "2017", title: "Referência Regional", text: "Consolidação como referência em pedras naturais em toda a região de Botucatu." },
  { year: "2021", title: "Porcelanato Técnico", text: "Inclusão de serviços especializados em porcelanato de grandes formatos." },
  { year: "2024", title: "500+ Projetos", text: "Marco de mais de 500 projetos realizados com excelência e satisfação total." },
];

const values = [
  {
    icon: "shield",
    title: "Qualidade Incomparável",
    text: "Utilizamos apenas materiais de primeira linha, selecionados das melhores pedreiras do Brasil e do mundo.",
  },
  {
    icon: "heart",
    title: "Dedicação Artesanal",
    text: "Cada peça é tratada com cuidado artesanal, garantindo acabamentos que superam expectativas.",
  },
  {
    icon: "users",
    title: "Atendimento Humanizado",
    text: "Do primeiro contato à entrega final, nosso atendimento é personalizado e transparente.",
  },
  {
    icon: "target",
    title: "Precisão Técnica",
    text: "Equipamentos de última geração e profissionais certificados garantem cortes milimétricos.",
  },
];
---

<Layout
  title="Sobre a Marmoraria Botucatu | Nossa História e Valores"
  description="Conheça a Marmoraria Botucatu. 15+ anos de excelência em mármore, granito e porcelanato em Botucatu, SP. Nossa história."
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative pt-24 pb-16 lg:pt-32 lg:pb-24 bg-stone-950 overflow-hidden">
      <div class="absolute inset-0">
        <img src="/images/about.png" alt="Equipe da Marmoraria Botucatu" class="h-full w-full object-cover opacity-30" loading="eager" />
        <div class="absolute inset-0 bg-gradient-to-r from-stone-950 via-stone-950/80 to-stone-950/50"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-stone-950 via-transparent to-stone-950/60"></div>
      </div>
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>

      <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-8 flex items-center gap-2 text-sm" aria-label="Breadcrumb">
          <a href="/" class="text-stone-400 hover:text-gold transition-colors">Início</a>
          <svg class="h-4 w-4 text-stone-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
          <span class="text-gold">Sobre Nós</span>
        </nav>

        <div class="mb-6 inline-flex items-center gap-2.5 rounded-full border border-gold/20 bg-gold/5 px-5 py-2 backdrop-blur-md">
          <span class="h-2 w-2 rounded-full bg-gold animate-pulse"></span>
          <span class="text-xs font-semibold tracking-[0.2em] text-gold uppercase">Nossa História</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white max-w-3xl leading-[1.1]">
          Tradição e Excelência em <span class="text-gold">Pedras Naturais</span>
        </h1>
        <p class="mt-6 text-lg text-stone-400 max-w-2xl leading-relaxed">
          Há mais de 15 anos transformando ambientes em Botucatu e região com mármore, granito e porcelanato de alto padrão.
        </p>
      </div>
    </section>

    <!-- About Content -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-12 lg:grid-cols-2 lg:gap-20 items-center">
          <!-- Image -->
          <div class="relative">
            <div class="overflow-hidden rounded-2xl shadow-xl">
              <img src="/images/about.png" alt="Equipe da Marmoraria Botucatu trabalhando" class="h-full w-full object-cover aspect-[4/3]" loading="lazy" />
            </div>
            <div class="absolute -bottom-6 -right-4 flex gap-3 sm:-right-6">
              <div class="flex flex-col items-center rounded-xl bg-stone-900 px-5 py-4 shadow-xl">
                <span class="text-2xl font-serif font-bold text-gold">15+</span>
                <span class="text-xs text-stone-400 text-center leading-tight mt-1">Anos de<br/>Experiência</span>
              </div>
              <div class="flex flex-col items-center rounded-xl bg-stone-900 px-5 py-4 shadow-xl">
                <span class="text-2xl font-serif font-bold text-gold">500+</span>
                <span class="text-xs text-stone-400 text-center leading-tight mt-1">Projetos<br/>Realizados</span>
              </div>
            </div>
            <div class="absolute -top-4 -left-4 h-20 w-20 rounded-tl-2xl border-l-4 border-t-4 border-gold/30 hidden lg:block"></div>
          </div>

          <!-- Text -->
          <div>
            <span class="text-sm font-semibold tracking-widest uppercase text-gold">Quem Somos</span>
            <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">
              Marmoraria Botucatu
            </h2>
            <div class="mt-4 h-1 w-12 rounded-full bg-gold"></div>

            <p class="mt-6 text-base leading-relaxed text-stone-600">
              Fundada com a paixão pelas pedras naturais, a Marmoraria Botucatu nasceu do sonho de oferecer acabamentos de alto padrão acessíveis a toda a região. Ao longo de mais de 15 anos, construímos uma reputação sólida baseada na qualidade dos nossos serviços e no compromisso com cada cliente.
            </p>
            <p class="mt-4 text-base leading-relaxed text-stone-600">
              Nossa equipe é formada por profissionais altamente qualificados, com anos de experiência no manuseio e instalação de mármores, granitos e porcelanatos. Utilizamos equipamentos de última geração que garantem cortes precisos e acabamentos impecáveis em cada projeto.
            </p>
            <p class="mt-4 text-base leading-relaxed text-stone-600">
              Trabalhamos lado a lado com arquitetos, designers de interiores e famílias que buscam o melhor para seus espaços. Do primeiro contato à entrega final, nosso compromisso é superar expectativas.
            </p>

            <ul class="mt-8 space-y-3">
              {["Equipe especializada com certificação profissional", "Materiais selecionados das melhores pedreiras do Brasil", "Atendimento personalizado em toda Botucatu e região", "Equipamentos CNC de última geração", "Garantia de satisfação em todos os projetos"].map((item) => (
                <li class="flex items-start gap-3">
                  <div class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-gold/10">
                    <svg class="h-3.5 w-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </div>
                  <span class="text-stone-600 text-sm">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="py-16 lg:py-24 bg-stone-50">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <span class="text-sm font-semibold tracking-widest uppercase text-gold">Nossos Pilares</span>
          <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">Valores que nos Guiam</h2>
          <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gold"></div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          {values.map((v) => (
            <div class="group rounded-2xl bg-white p-6 shadow-sm border border-stone-100 text-center transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
              <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gold/10 text-gold transition-colors group-hover:bg-gold group-hover:text-white">
                {v.icon === "shield" && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>}
                {v.icon === "heart" && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" /></svg>}
                {v.icon === "users" && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>}
                {v.icon === "target" && <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09Z" /></svg>}
              </div>
              <h3 class="font-serif text-lg font-semibold text-stone-800">{v.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-500">{v.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section class="py-16 lg:py-24 bg-white">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-16">
          <span class="text-sm font-semibold tracking-widest uppercase text-gold">Linha do Tempo</span>
          <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">Nossa Trajetória</h2>
          <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gold"></div>
        </div>

        <div class="relative">
          <!-- Vertical line -->
          <div class="absolute left-6 top-0 bottom-0 w-px bg-stone-200 sm:left-1/2"></div>

          <div class="space-y-12">
            {timeline.map((item, i) => (
              <div class={`relative flex items-start gap-6 ${i % 2 === 0 ? 'sm:flex-row' : 'sm:flex-row-reverse'}`}>
                <!-- Dot -->
                <div class="absolute left-6 sm:left-1/2 -translate-x-1/2 flex h-12 w-12 items-center justify-center rounded-full bg-gold text-white font-serif font-bold text-xs z-10">
                  {item.year}
                </div>
                <!-- Content -->
                <div class={`ml-20 sm:ml-0 sm:w-[calc(50%-2rem)] ${i % 2 === 0 ? 'sm:pr-8 sm:text-right' : 'sm:pl-8 sm:ml-auto'}`}>
                  <div class="rounded-xl bg-stone-50 border border-stone-100 p-5 shadow-sm">
                    <h3 class="font-serif text-lg font-semibold text-stone-800">{item.title}</h3>
                    <p class="mt-1 text-sm text-stone-500">{item.text}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Services preview -->
    <section class="py-16 lg:py-20 bg-stone-50 border-t border-stone-200">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center mb-12">
          <span class="text-sm font-semibold tracking-widest uppercase text-gold">Conheça nosso trabalho</span>
          <h2 class="mt-3 font-serif text-2xl sm:text-3xl font-bold text-stone-800">Nossos Serviços</h2>
          <div class="mx-auto mt-4 h-1 w-12 rounded-full bg-gold"></div>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s) => (
            <a href={`/servicos/${s.slug}/`} class="group flex items-center gap-4 rounded-xl bg-white p-4 border border-stone-100 shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5">
              <div class="h-16 w-16 flex-shrink-0 overflow-hidden rounded-lg">
                <img src={s.image} alt={s.alt} class="h-full w-full object-cover transition-transform group-hover:scale-110" loading="lazy" />
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="text-sm font-semibold text-stone-800 group-hover:text-gold transition-colors truncate">{s.title}</h3>
                <p class="text-xs text-stone-500 mt-0.5 truncate">{s.description}</p>
              </div>
              <svg class="h-4 w-4 text-stone-300 group-hover:text-gold transition-colors flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-16 lg:py-20 bg-stone-950">
      <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
        <span class="text-sm font-semibold tracking-widest uppercase text-gold">Vamos conversar</span>
        <h2 class="mt-4 font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-white">
          Conheça Nosso Trabalho <span class="text-gold">Pessoalmente</span>
        </h2>
        <p class="mt-4 text-stone-400 max-w-xl mx-auto">
          Visite nossa marmoraria em Botucatu ou entre em contato pelo WhatsApp para conhecer nossos materiais e projetos.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-3 rounded-full bg-[#25D366] px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all hover:bg-[#1fb855] hover:shadow-xl hover:-translate-y-0.5">
            <svg class="h-6 w-6 transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.75.75 0 0 0 .917.918l4.458-1.495A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.35 0-4.531-.69-6.379-1.872l-.447-.287-2.648.888.888-2.648-.287-.447A9.724 9.724 0 0 1 2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75z"/></svg>
            Chamar no WhatsApp
          </a>
          <a href="/contato/" class="inline-flex items-center gap-2 rounded-full border border-stone-600 px-8 py-4 text-base font-medium text-stone-300 transition-all hover:bg-white/5 hover:border-gold/50 hover:text-white">
            Ver Contato Completo
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
