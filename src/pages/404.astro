---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
---

<Layout
  title="Página não encontrada | Marmoraria Botucatu"
  description="A página que você procura não foi encontrada. Volte para o início ou entre em contato com a Marmoraria Botucatu."
>
  <Header />

  <main>
    <section class="relative min-h-[80vh] flex items-center bg-stone-950 overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-stone-900 via-stone-950 to-stone-900"></div>
      <div class="absolute top-0 left-0 w-full h-px bg-gradient-to-r from-transparent via-gold/30 to-transparent"></div>
      <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, rgba(176, 141, 87, 0.5) 1px, transparent 0); background-size: 40px 40px;"></div>

      <div class="relative z-10 mx-auto max-w-3xl px-4 py-32 text-center sm:px-6 lg:px-8">
        <p class="font-serif text-8xl font-bold text-gold/20 select-none">404</p>

        <div class="mt-4 mb-6 inline-flex items-center gap-2.5 rounded-full border border-gold/20 bg-gold/5 px-5 py-2 backdrop-blur-md">
          <span class="h-2 w-2 rounded-full bg-gold"></span>
          <span class="text-xs font-semibold tracking-[0.2em] text-gold uppercase">Página não encontrada</span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-white leading-tight">
          Essa página não <span class="text-gold">existe</span>
        </h1>
        <p class="mt-6 text-lg text-stone-400 max-w-xl mx-auto leading-relaxed">
          O endereço que você acessou não foi encontrado. Talvez o link esteja incorreto ou a página tenha sido removida.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-2 rounded-full bg-gold px-8 py-4 text-sm font-semibold text-stone-950 transition-all hover:bg-gold/90 hover:-translate-y-0.5 shadow-lg shadow-gold/20"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
            Voltar ao início
          </a>
          <a
            href="/contato/"
            class="inline-flex items-center gap-2 rounded-full border border-stone-700 bg-stone-800/50 px-8 py-4 text-sm font-semibold text-stone-300 transition-all hover:border-gold/50 hover:text-gold hover:-translate-y-0.5"
          >
            Falar conosco
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppButton />
</Layout>
